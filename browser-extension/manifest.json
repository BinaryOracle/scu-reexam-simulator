{
  "manifest_version": 3,
  "name": "知序 · 多平台评测提交桥接",
  "version": "1.3.0",
  "description": "通过用户已登录的洛谷或 LeetCode 中国区（leetcode.cn）页面提交代码；不会读取或上传密码、Cookie。",
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": ["https://www.luogu.com.cn/*", "https://leetcode.cn/*", "http://127.0.0.1:8000/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "options_page": "options.html",
  "content_scripts": []
}
